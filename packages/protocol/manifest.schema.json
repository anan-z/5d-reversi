{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://5d-reversi/schemas/agent-manifest.schema.json",
  "title": "PlayerAgent Manifest",
  "description": "Declarative description of an AI agent, its identity, and the parameters it exposes. The shell validates an imported agent's manifest against this schema before rendering any settings UI or running any agent code.",
  "type": "object",
  "required": ["name", "author", "version", "protocolVersion", "params"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "description": "Agent's own semver, independent of protocolVersion.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "protocolVersion": {
      "type": "string",
      "description": "Must exactly match a version this shell recognizes. The shell refuses to load an agent whose protocolVersion it doesn't know rather than guessing compatibility.",
      "enum": ["0.1"]
    },
    "description": {
      "type": "string",
      "maxLength": 280
    },
    "params": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/definitions/param" }
    }
  },
  "definitions": {
    "param": {
      "type": "object",
      "required": ["key", "label", "type", "default"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "description": "Identifier used as the lookup key in paramValues passed to init(). Must be unique within the params array."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Human-readable label the shell renders in the settings form."
        },
        "type": {
          "type": "string",
          "enum": ["enum", "number", "boolean"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "enum" } } },
          "then": {
            "required": ["options", "default"],
            "properties": {
              "options": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "default": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "number" } } },
          "then": {
            "required": ["min", "max", "default"],
            "properties": {
              "min": { "type": "number" },
              "max": { "type": "number" },
              "step": { "type": "number" },
              "default": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } } },
          "then": {
            "required": ["default"],
            "properties": {
              "default": { "type": "boolean" }
            }
          }
        }
      ]
    }
  }
}
